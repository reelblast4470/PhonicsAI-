# Copy to .env for local dev. NEVER commit real values; production injects
# these via the deploy platform (systemd env / k8s secret / PaaS settings).
# Unset = the default shown. All are read by app/config.py.

ENVIRONMENT=dev                          # dev | staging | production
DATABASE_URL=postgresql+asyncpg://phonicsai:devlocal_only_not_a_secret@127.0.0.1:5432/phonicsai

# --- security (production refuses to boot with the dev defaults) ------------
JWT_SECRET=dev-only-insecure-change-me   # production: openssl rand -hex 32
JWT_AUDIENCE=phonicsai-api
ACCESS_TOKEN_MINUTES=15                  # parent/admin bearer lifetime
LEARNER_TOKEN_HOURS=12                   # child device token (offline days ok)
REFRESH_TOKEN_DAYS=30                    # rotating; reuse revokes the family
CORS_ORIGINS=http://localhost:8080       # comma-separated or JSON list

# --- rate limits (slowapi syntax, per client IP) -----------------------------
DEFAULT_RATE_LIMIT=120/minute            # global default; tighter per-route
                                         # limits (login 5/min, auth 8/min,
                                         # register 3/min) are constants in
                                         # app/limiter.py — keep in sync there.
TRUSTED_PROXY_HOPS=0                     # reserved: set when behind a proxy
                                         # that rewrites X-Forwarded-For

# --- email ------------------------------------------------------------------
MAIL_MODE=outbox                         # outbox: writes .eml under OUTBOX_DIR
                                         # console: log only; wire SES/Postmark
                                         # here in production (never in clients)
OUTBOX_DIR=data/outbox
APP_PUBLIC_BASE=http://localhost:5173    # base for verify/reset links in mail

# --- tokens & content ---------------------------------------------------------
EMAIL_VERIFICATION_HOURS=24
PASSWORD_RESET_MINUTES=60
MAX_EVENT_BATCH=50

# --- seeding (dev only; run `python -m app.seed` manually) ------------------
# SEED_ADMIN=1 ADMIN_BOOTSTRAP_USERNAME=admin-dev ADMIN_BOOTSTRAP_PASSWORD=...
# Read by app/seed.py. DELETE the admin (or rotate its password) before any
# deployment that is reachable outside your machine.
